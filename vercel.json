{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/open-finance.ts": {
      "maxDuration": 60
    },
    "api/dante.ts": {
      "maxDuration": 60
    }
  }
}
